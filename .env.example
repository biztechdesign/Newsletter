# Copy this file to ".env" in the same folder and fill in the three values.
#
#     copy .env.example .env
#
# .env is gitignored, so the credentials stay on your machine. This example
# file carries no secrets and is safe to commit.
#
# Used by: python upload_sections.py

# --- required -------------------------------------------------------------
NEWSLETTER_FTP_HOST=ftp.yourhost.com
NEWSLETTER_FTP_USER=your-username
NEWSLETTER_FTP_PASS=your-password

# --- optional -------------------------------------------------------------
# Folder on the server holding one subfolder per issue (July_2026, and so on).
# Leave commented to use the default below.
# NEWSLETTER_FTP_DIR=/home/wordpress/public_html/biztech-insider

# Protocol is detected from whichever port answers: 22 -> SFTP, 21 -> FTP.
# Set this only to skip the probe.
# NEWSLETTER_FTP_PROTOCOL=sftp

# FTP only: FTPS is attempted first and falls back to plain FTP on its own.
# NEWSLETTER_FTP_TLS=1
