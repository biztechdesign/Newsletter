# Generated newsletter output — rebuilt from the sheet by import_content.py
# Rendered HTML now lives in "<Month>-<Year>/HTML", generated each run
*/HTML/newsletter_*.html

# Flattened section PNGs, regenerated by screenshot_sections.py each run.
# The month's source photos in "<Month>-<Year>/Row Data" are NOT ignored, so
# they can still be committed if you want them backed up in git.
*/Section wise images/

# FTP credentials for upload_sections.py — must never be committed.
# .env.example is the blank template and IS tracked.
.env
ftp_config.json

# Excel's lock file, created while a workbook is open
~$*

# Backups written by migrate_to_master.py
*.old.xlsx
*.xlsx.bak

__pycache__/
*.pyc

.blender-toolkit/
